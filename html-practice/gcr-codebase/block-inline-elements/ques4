    <aside>
        <blockquote>
            "Our goal is to use technology to create meaningful solutions."
        </blockquote>
    </aside>

    <footer id="contact">
        <p>Email: contact@techsolutions.example</p>
        <p>Address: 123 Business Road, New Delhi, India</p>
    </footer>

