<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dropdown Selection</title>
</head>
<body>

    <h1>Travel Selection</h1>

    <form>
        <label for="country">Country:</label>
        <select id="country" name="country">
            <option selected>India</option>
            <option>France</option>
            <option>Japan</option>
            <option>UAE</option>
        </select>

        <br><br>

        <label for="state">State:</label>
        <select id="state" name="state">
            <option selected>Uttar Pradesh</option>
            <option>Delhi</option>
            <option>Maharashtra</option>
            <option>Rajasthan</option>
        </select>

        <br><br>

        <label for="city">City:</label>
        <select id="city" name="city">
            <option selected>Agra</option>
            <option>Lucknow</option>
            <option>Jaipur</option>
            <option>Mumbai</option>
        </select>

        <br><br>

        <label for="place">Favorite Tourist Place:</label>
        <select id="place" name="place">
            <option selected>Taj Mahal</option>
            <option>Agra Fort</option>
            <option>India Gate</option>
            <option>Gateway of India</option>
        </select>
    </form>

    <p>
        My choices are India, Uttar Pradesh, Agra, and Taj Mahal.
    </p>

</body>
</html>
