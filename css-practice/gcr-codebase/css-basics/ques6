<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photo Gallery</title>
    <link rel="stylesheet" href="question6.css">
</head>
<body>

    <main>
        <h1>Photo Gallery</h1>

        <section class="gallery">

            <figure>
                <img src="photo1.jpg" alt="Mountain">
                <figcaption>Mountain View</figcaption>
            </figure>

            <figure>
                <img src="photo2.jpg" alt="Beach">
                <figcaption>Beautiful Beach</figcaption>
            </figure>

            <figure>
                <img src="photo3.jpg" alt="Forest">
                <figcaption>Green Forest</figcaption>
            </figure>

            <figure>
                <img src="photo4.jpg" alt="City">
                <figcaption>City Lights</figcaption>
            </figure>

            <figure>
                <img src="photo5.jpg" alt="Lake">
                <figcaption>Peaceful Lake</figcaption>
            </figure>

            <figure>
                <img src="photo6.jpg" alt="Desert">
                <figcaption>Golden Desert</figcaption>
            </figure>

        </section>
    </main>

</body>
</html>
